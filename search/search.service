# Install with:  sudo bash search/install_service.sh   (logs: journalctl -u search -f)
# That script replaces User= and WorkingDirectory= below with your user and the real
# folder, so you don't need to edit them by hand.
[Unit]
Description=Mini-Google search API (FastAPI)
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/dse/search
Environment=SERVING_ROOT=/serving
ExecStart=/opt/searchenv/bin/uvicorn app:app --host 0.0.0.0 --port 8000 --workers 1
Restart=on-failure

[Install]
WantedBy=multi-user.target
